@page
@model aspnetWebApp.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="form-container">
    <h1>Регистрация</h1>
    <p class="description">Создайте аккаунт, чтобы продолжить</p>

    <form method="post" id="register-form">
        @Html.AntiForgeryToken()

        @* Общий блок ошибок валидации *@
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Input.Email">Email:</label>
            <input asp-for="Input.Email" placeholder="email@example.com" required />
            <span asp-validation-for="Input.Email"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Password">Пароль:</label>
            <input asp-for="Input.Password" type="password" placeholder="Минимум 6 символов" required />
            <span asp-validation-for="Input.Password"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.ConfirmPassword">Повторите пароль:</label>
            <input asp-for="Input.ConfirmPassword" type="password" required />
            <span asp-validation-for="Input.ConfirmPassword"></span>
        </div>

        <button type="submit" class="form-button">Зарегистрироваться</button>
    </form>

    <p style="text-align:center; margin-top:15px;">
        Уже есть аккаунт?
        <a asp-page="/Account/Login">Войти</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}