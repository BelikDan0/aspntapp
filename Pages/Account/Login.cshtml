@page
@model aspnetWebApp.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<div class="form-container">
    <h1>Вход в систему</h1>
    <p class="description">Введите свои учётные данные</p>

    <form method="post" id="login-form">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Input.Email">Email:</label>
            <input asp-for="Input.Email" placeholder="email@example.com" required />
            <span asp-validation-for="Input.Email"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Password">Пароль:</label>
            <input asp-for="Input.Password" type="password" required />
            <span asp-validation-for="Input.Password"></span>
        </div>


        <button type="submit" class="form-button">Войти</button>
    </form>

    <p style="text-align:center; margin-top:15px;">
        Нет аккаунта?
        <a asp-page="/Account/Register">Зарегистрироваться</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}