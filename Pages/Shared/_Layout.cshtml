<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - aspnetWebApp</title>
    <script type="importmap"></script>
   <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
     
    <nav class="nav">
    <a class="footer-logo-main" asp-page="Index">
                College<span>Job</span>

        </a>
    <ul class="nav-ul">
            <li class="nav-item">
                <a class="nav-link" asp-page="/index">
                Главная</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-page="/Resumes">
                Резюме</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/Vacancys">
                Вакансии</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-page="/CreateResume">
                Создание резюме</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-page="/CreateVacancy">
                Создание вакансии</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-page="/About">
                О нас</a>
            </li>
        </ul>
    </nav>
    

   

    <main role="main" class="pb-3 main-content">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="footer-container">
            <a class="footer-logo" asp-page="Index">
                College<span>Job</span>
            </a>
            <p>Платформа для старта в проффесиональнйо карьеры</p>
            <span class="footer-copy">
            @DateTime.Now.Year CollegeJob</span>
        </div>
        
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
