@page
@model IndexModel
@* @{
    Layout = null;
    } *@

@* @{
    ViewData["Title"] = "Home page";
    } *@

<div class="form-container">

    <h1>Анкета студента</h1>

    <p class="description">
        Введите свои данные
    </p>

    <form method="post">

        <div class="form-group">
            <label>Имя-фамилия:</label>
            <input type="text" name="Name" placeholder="Введите имя" required>
        </div>

        <div class="form-group">
            <label>Номер телефона:</label>
            <input type="tel" name="Phone" placeholder="+7" required>
        </div>

        <div class="form-group">
            <label>Email:</label>
            <input type="email" name="Email" placeholder="email@example.com" required>
        </div>
        <div class="form-group">
            <label for="city">Город:</label>
            <select name="City" id="city">
                <option value="Москва">Москва</option>
                <option value="Санкт-Петербург">Санкт-Петербург</option>
                <option value="Краснодар">Краснодар</option>
                <option value="Сочи">Сочи</option>
            </select>
        </div>


        <div class="form-group">
            <label>Специальность:</label>

            <div class="speciality">

                <input type="radio" name="Speciality" value="Программирование" id="dev">
                <label for="dev">Программирование</label>

                <br>

                <input type="radio" name="Speciality" value="Дизайн" id="design">
                <label for="design">Дизайн</label>

                <br>

                <input type="radio" name="Speciality" value="Маркетинг" id="marketing">
                <label for="marketing">Маркетинг</label>

            </div>
        </div>
        <div class="form-group">
            <label>Язык програмирования:</label>
            <div class="language">
                <input type="radio" name="Language" value="Java" id="java">
                <label for="java">Java</label>

                <br>

                <input type="radio" name="Language" value="Kotlin" id="kotlin">
                <label for="kotlin">Kotlin</label>

                <br>

                <input type="radio" name="Language" value="C++" id="c++">
                <label for="c++">C++</label>
            </div>
        </div>
        <div class="form-group">
            <label>Формат обучения:</label>
            <div class="format-l">
                <input type="radio" name="Format" value="Очно" id="ochno">
                <label for="ochno">Очно</label>

                <br>

                <input type="radio" name="Format" value="Заочно" id="zaochno">
                <label for="zaochno">Заочно</label>

                <br>

                <input type="radio" name="Format" value="Дистанционно" id="distance">
                <label for="distance">Дистанционно</label>
            </div>
        </div>
        <div class="form-group">
            <label for="courses">Курс:</label>
            <select name="Course" id="courses">
                <option value="1 курс">1 курс</option>
                <option value="2 курс">2 курс</option>
                <option value="3 курс">3 курс</option>
                <option value="4 курс">4 курс</option>
            </select>
        </div>
        <div class="form-group">
            <label for="">Дата рождения:</label>
            <input type="date" name="BirthDate" required>
        </div>
        <div class="form-group">
            <label for="">Технологии:</label>
            <div class="speciality">
                <input type="checkbox" name="Technologies" value="HTML/CSS" id="html">
                <label for="html">HTML/CSS</label>
                <br>
                <input type="checkbox" name="Technologies" value="JavaScript" id="js">
                <label for="js">JavaScript</label>
                <br>
                <input type="checkbox" name="Technologies" value="C#" id="csharp">
                <label for="csharp">C#</label>
                <br>
                <input type="checkbox" name="Technologies" value="Python" id="python">
                <label for="python">Python</label>
                <br>
                <input type="checkbox" name="Technologies" value="Docker" id="docker">
                <label for="Docker">Docker</label>
                <br>
                <input type="checkbox" name="Technologies" value="React" id="react">
                <label for="react">React</label>
            </div>
        </div>
        <button class="form-button" type="submit">
            Отправить
        </button>

    </form>
    <div id="result" class="result">
        <div class="student-card-header">
            <h2>Анкета отправленна</h2>
            <p>Данные студента</p>
        </div>
        <div class="student-info">
            <div class="info-item">
                <strong>Имя студента:</strong>
                <span id="result-name"></span>
            </div>
            <div class="info-item">
                <strong>Телефон:</strong>
                <span id="result-phone"></span>
            </div>
            <div class="info-item">
                <strong>Почта:</strong>
                <span id="result-email"></span>
            </div>
            <div class="info-item">
                <strong>Город:</strong>
                <span id="result-city"></span>
            </div>
            <div class="info-item">
                <strong>Специальность:</strong>
                <span id="result-speciality"></span>
            </div>
            <div class="info-item">
                <strong>Язык:</strong>
                <span id="result-language"></span>
            </div>
            <div class="info-item">
                <strong>Курс:</strong>
                <span id="result-course"></span>
            </div>
            <div class="info-item">
                <strong>Дата рождения:</strong>
                <span id="result-bithdate"></span>
            </div>
            <div class="info-item">
                <strong>Технологии:</strong>
                <span id="result-technologies"></span>
            </div>
        </div>
    </div>



</div>
<script>
    const form = document.querySelector("form");

    form.addEventListener("submit", async function (event) {
        event.preventDefault();

        const button = form.querySelector("button");
        button.textContent = "Отправка.";
        button.disabled = true;

        try {
            const formData = new FormData(form);

            const response = await fetch("", {
                method: "POST",
                body: formData
            });

            if (!response.ok) {
                throw new Error(`HTTP ${response.status}`);
            }

            const data = await response.json();
            console.log(data);
            document.querySelector("#result").classList.add("visible");

            document.querySelector("#result-name").textContent         = data.name ?? "Не указано";
            document.querySelector("#result-phone").textContent        = data.phone ?? "Не указано";
            document.querySelector("#result-email").textContent        = data.email ?? "Не указано";
            document.querySelector("#result-city").textContent         = data.city ?? "Не указано";
            document.querySelector("#result-speciality").textContent   = data.speciality ?? "Не указано";
            document.querySelector("#result-language").textContent     = data.language ?? "Не указано";
            document.querySelector("#result-course").textContent       = data.course ?? "Не указано";
            document.querySelector("#result-bithdate").textContent     = data.birthDate ?? "Не указано";
            document.querySelector("#result-technologies").textContent =
                Array.isArray(data.technologies)
                    ? data.technologies.join(", ")
                    : (data.technologies ?? "");

            button.textContent = "Анкета отправлена";
        } catch (err) {
            console.error("Ошибка при отправке:", err);
            button.textContent = "Ошибка отправки";
        } finally {
            button.disabled = false;
        }
    });
</script>
